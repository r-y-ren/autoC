{
  "hooks": {
    "enabled": true,
    "timeoutMs": 8000,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "enabled": false,
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/guard/session_status.py"
              ],
              "timeoutMs": 3000
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "enabled": false,
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/guard/guard_path.py"
              ],
              "timeoutMs": 5000
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "enabled": false,
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/kb/lint_kb.py",
                "--hook"
              ],
              "timeoutMs": 8000
            }
          ]
        }
      ]
    }
  }
}
