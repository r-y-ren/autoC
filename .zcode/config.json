{
  "hooks": {
    "enabled": true,
    "timeoutMs": 8000,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/scripts/guard/guard_path.py"],
              "timeoutMs": 5000
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/scripts/kb/lint_kb.py", "--hook"],
              "timeoutMs": 8000
            }
          ]
        }
      ]
    }
  }
}
