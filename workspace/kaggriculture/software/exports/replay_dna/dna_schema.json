{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaggriculture.replay-dna.schema.json",
  "title": "Offline replay DNA forensics artifacts",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "properties": {
        "artifact_kind": {
          "const": "dna_index"
        },
        "schema_version": {
          "const": "replay-dna/1.1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_scope": {
          "$ref": "#/$defs/scope"
        },
        "source_manifest": {
          "$ref": "#/$defs/manifest"
        },
        "report_path": {
          "enum": [
            "workspace/software/exports/replay_dna/report.json",
            "workspace/kaggriculture/software/exports/replay_dna/report.json"
          ]
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "digests": {
          "$ref": "#/$defs/digests"
        },
        "implementation_manifest": {
          "$ref": "#/$defs/implementation_manifest"
        }
      },
      "required": [
        "artifact_kind",
        "schema_version",
        "generated_at",
        "evidence_scope",
        "source_manifest",
        "report_path",
        "report_sha256",
        "counts",
        "command",
        "digests",
        "implementation_manifest"
      ]
    },
    {
      "properties": {
        "artifact_kind": {
          "const": "dna_report"
        },
        "schema_version": {
          "const": "replay-dna/1.1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_scope": {
          "$ref": "#/$defs/scope"
        },
        "source_manifest": {
          "$ref": "#/$defs/manifest"
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "supplied_consensus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplied_consensus"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "digests": {
          "$ref": "#/$defs/digests"
        },
        "implementation_manifest": {
          "$ref": "#/$defs/implementation_manifest"
        }
      },
      "required": [
        "artifact_kind",
        "schema_version",
        "generated_at",
        "evidence_scope",
        "source_manifest",
        "samples",
        "groups",
        "supplied_consensus",
        "references",
        "comparisons",
        "summary",
        "command",
        "digests",
        "implementation_manifest"
      ]
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offline_exploratory",
        "strength_claim",
        "promotion_eligible",
        "holdout_evidence",
        "online_evidence",
        "engine_activity_evidence",
        "extractor_status",
        "identity_interpretation",
        "grouping_policy"
      ],
      "properties": {
        "kind": {
          "const": "offline_dna_liveness_forensics"
        },
        "offline_exploratory": {
          "const": true
        },
        "strength_claim": {
          "const": false
        },
        "promotion_eligible": {
          "const": false
        },
        "holdout_evidence": {
          "const": false
        },
        "online_evidence": {
          "const": false
        },
        "engine_activity_evidence": {
          "const": false
        },
        "extractor_status": {
          "const": "source_extractor_not_published"
        },
        "identity_interpretation": {
          "const": "IDENTICAL / SAME SOURCE means 30-band anchor equality only; it does not prove same agent or real source"
        },
        "grouping_policy": {
          "const": "submission_all_input_episodes_both_seats"
        }
      }
    },
    "manifest": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "role",
          "source_url",
          "capture_dates"
        ],
        "properties": {
          "name": {
            "enum": [
              "barcodes.csv",
              "consensus.csv",
              "reference_barcodes.csv",
              "field_validation.json"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(workspace/kaggriculture/references/data/replay-dna|\\.tmp-dna)/(barcodes|consensus|reference_barcodes|field_validation)\\.(csv|json)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "const": "https://www.kaggle.com/datasets/destbreso/kaggriculture-replay-genomes"
          },
          "capture_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "bands": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{10}$"
      }
    },
    "genome": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_date",
        "submission",
        "team",
        "seat",
        "episode_id",
        "bands",
        "genome_id"
      ],
      "properties": {
        "capture_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "submission": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "seat": {
          "enum": [
            0,
            1
          ]
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "bands": {
          "$ref": "#/$defs/bands"
        },
        "genome_id": {
          "$ref": "#/$defs/genome"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "grouping",
        "submission",
        "team",
        "episode_count",
        "episode_ids",
        "capture_dates",
        "consensus_bands",
        "consensus_genome_id",
        "stability",
        "locus_agreements",
        "liveness_scope",
        "engine_activity_evidence"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "grouping": {
          "const": "submission_all_input_episodes_both_seats"
        },
        "submission": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "episode_count": {
          "type": "integer",
          "minimum": 1
        },
        "episode_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capture_dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "uniqueItems": true
        },
        "consensus_bands": {
          "$ref": "#/$defs/bands"
        },
        "consensus_genome_id": {
          "$ref": "#/$defs/genome"
        },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "locus_agreements": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "liveness_scope": {
          "const": "dna_sample_stability_only"
        },
        "engine_activity_evidence": {
          "const": false
        }
      }
    },
    "supplied_consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_date",
        "submission",
        "team",
        "episodes",
        "genome_id",
        "bands",
        "producer_self_agreement",
        "authority"
      ],
      "properties": {
        "capture_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "submission": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "episodes": {
          "type": "integer",
          "minimum": 1
        },
        "genome_id": {
          "$ref": "#/$defs/genome"
        },
        "bands": {
          "$ref": "#/$defs/bands"
        },
        "producer_self_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "authority": {
          "const": "producer_attested_unseated_not_stability_authority"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "genome_id",
        "bands"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "genome_id": {
          "$ref": "#/$defs/genome"
        },
        "bands": {
          "$ref": "#/$defs/bands"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "group_genome_id",
        "reference_label",
        "reference_genome_id",
        "matched_loci",
        "match_ratio",
        "fork_day",
        "log10_rmp",
        "rmp",
        "base_verdict",
        "verdict",
        "stability_a",
        "stability_b",
        "minimum_assessed_stability",
        "stability_assessment",
        "field_frequency_floor",
        "matched_frequencies"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "group_genome_id": {
          "$ref": "#/$defs/genome"
        },
        "reference_label": {
          "type": "string",
          "minLength": 1
        },
        "reference_genome_id": {
          "$ref": "#/$defs/genome"
        },
        "matched_loci": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "match_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fork_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 29
        },
        "log10_rmp": {
          "type": "number"
        },
        "rmp": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "base_verdict": {
          "enum": [
            "IDENTICAL / SAME SOURCE",
            "RELATED",
            "WEAK SIGNAL",
            "UNRELATED"
          ]
        },
        "verdict": {
          "enum": [
            "IDENTICAL / SAME SOURCE",
            "RELATED",
            "WEAK SIGNAL",
            "UNRELATED",
            "OUT OF RANGE"
          ]
        },
        "stability_a": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "stability_b": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "minimum_assessed_stability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "stability_assessment": {
          "enum": [
            "stability_assessed",
            "stability_partially_assessed",
            "stability_unassessed"
          ]
        },
        "field_frequency_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "matched_frequencies": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "group_count",
        "supplied_consensus_count",
        "reference_count",
        "comparison_count",
        "verdict_counts",
        "stability_below_0_6_groups",
        "stability_unassessed_comparisons"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "group_count": {
          "type": "integer",
          "minimum": 1
        },
        "supplied_consensus_count": {
          "type": "integer",
          "minimum": 0
        },
        "reference_count": {
          "type": "integer",
          "minimum": 1
        },
        "comparison_count": {
          "type": "integer",
          "minimum": 0
        },
        "verdict_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "IDENTICAL / SAME SOURCE": {
              "type": "integer",
              "minimum": 0
            },
            "RELATED": {
              "type": "integer",
              "minimum": 0
            },
            "WEAK SIGNAL": {
              "type": "integer",
              "minimum": 0
            },
            "UNRELATED": {
              "type": "integer",
              "minimum": 0
            },
            "OUT OF RANGE": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "IDENTICAL / SAME SOURCE",
            "RELATED",
            "WEAK SIGNAL",
            "UNRELATED",
            "OUT OF RANGE"
          ]
        },
        "stability_below_0_6_groups": {
          "type": "integer",
          "minimum": 0
        },
        "stability_unassessed_comparisons": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "groups",
        "comparisons"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "groups": {
          "type": "integer",
          "minimum": 1
        },
        "comparisons": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "parameters"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "implementation_manifest": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(workspace/kaggriculture/software|workspace/software)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonical_payload_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "canonical-json-sha256"
        },
        "canonical_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
