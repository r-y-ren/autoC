apiVersion: batch/v1
kind: Job
metadata:
  name: kaggriculture-ppo
  namespace: "${NAMESPACE}"
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: kaggriculture-ppo
    spec:
      restartPolicy: Never
      containers:
        - name: trainer
          image: "${TRAINING_IMAGE}"
          workingDir: /opt/kaggriculture
          command: ["python", "scripts/train_ppo.py"]
          args:
            - --config
            - configs/ppo.json
            - --bc-checkpoint
            - /work/models/initial-policy.pkl
            - --output-dir
            - /work/runs/ppo
            - --max-env-steps
            - "100000000"
          env:
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: XLA_PYTHON_CLIENT_PREALLOCATE
              value: "false"
          resources:
            requests:
              cpu: "8"
              memory: 24Gi
            limits:
              cpu: "8"
              memory: 24Gi
              nvidia.com/gpu: "1"
          volumeMounts:
            - name: work
              mountPath: /work
            - name: shared-memory
              mountPath: /dev/shm
      volumes:
        - name: work
          persistentVolumeClaim:
            claimName: "${WORK_PVC}"
        - name: shared-memory
          emptyDir:
            medium: Memory
            sizeLimit: 8Gi
