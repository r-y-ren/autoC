{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaggriculture.holdout-results.schema.json",
  "title": "Kaggriculture one-time official holdout evidence",
  "type": "object",
  "required": [
    "schema_version", "generated_at", "run_kind", "seed_domain", "identity",
    "evaluation_input", "engine", "config", "opponent_pool_names", "games",
    "abnormal_games", "integrity", "confirmatory", "elo", "holdout",
    "runtime_seconds"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "required": ["games", "W", "L", "T", "score_rate", "wilson95"],
      "additionalProperties": true,
      "properties": {
        "games": {"type": "integer", "minimum": 0},
        "W": {"type": "integer", "minimum": 0},
        "L": {"type": "integer", "minimum": 0},
        "T": {"type": "integer", "minimum": 0},
        "score_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "wilson95": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "run_kind": {"const": "official_holdout"},
    "seed_domain": {"const": "holdout"},
    "identity": {
      "type": "object",
      "required": ["submission_path", "submission_sha256", "git_ref", "dirty", "input_sha256"],
      "additionalProperties": false,
      "properties": {
        "submission_path": {"type": "string"},
        "submission_sha256": {"$ref": "#/$defs/sha256"},
        "git_ref": {"type": "string", "minLength": 7},
        "dirty": {"const": false},
        "input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluation_input": {
      "type": "object",
      "required": ["pairs", "seeds", "seed_domain", "seat_orders", "episode_steps", "run_kind"],
      "additionalProperties": false,
      "properties": {
        "pairs": {"type": "array", "minItems": 36, "maxItems": 36, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
        "seeds": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "seed_domain": {"const": "holdout"},
        "seat_orders": {"const": ["AB", "BA"]},
        "episode_steps": {"const": 720},
        "run_kind": {"const": "official_holdout"}
      }
    },
    "engine": {
      "type": "object",
      "required": ["package", "version", "scenario", "episode_steps"],
      "additionalProperties": false,
      "properties": {
        "package": {"type": "string"},
        "version": {"type": "string"},
        "scenario": {"const": "kaggriculture"},
        "episode_steps": {"const": 720}
      }
    },
    "config": {
      "type": "object",
      "required": ["rounds", "seeds", "matrix_order", "pairs", "seat_orders", "expected_games"],
      "additionalProperties": false,
      "properties": {
        "rounds": {"const": 8},
        "seeds": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "integer"}},
        "matrix_order": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "string"}},
        "pairs": {"type": "array", "minItems": 36, "maxItems": 36},
        "seat_orders": {"const": ["AB", "BA"]},
        "expected_games": {"const": 576}
      }
    },
    "opponent_pool_names": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
    "games": {
      "type": "array", "minItems": 576, "maxItems": 576,
      "items": {
        "type": "object",
        "required": ["players", "p0", "p1", "seed", "seed_domain", "seat", "statuses", "contract_ok", "rewards", "winner", "winner_label", "turns", "elapsed_seconds"],
        "additionalProperties": false,
        "properties": {
          "players": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "p0": {"type": "string"}, "p1": {"type": "string"},
          "seed": {"type": "integer"}, "seed_domain": {"const": "holdout"},
          "seat": {"enum": ["AB", "BA"]},
          "statuses": {"const": ["DONE", "DONE"]},
          "contract_ok": {"const": true},
          "rewards": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "winner": {"type": ["string", "null"]}, "winner_label": {"type": ["string", "null"]},
          "turns": {"const": 720}, "elapsed_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "abnormal_games": {"const": 0},
    "integrity": {
      "type": "object",
      "required": ["expected_games", "actual_games", "abnormal_games", "ab_games", "ba_games", "missing_mirrors"],
      "additionalProperties": false,
      "properties": {
        "expected_games": {"const": 576}, "actual_games": {"const": 576},
        "abnormal_games": {"const": 0}, "ab_games": {"const": 288},
        "ba_games": {"const": 288}, "missing_mirrors": {"const": 0}
      }
    },
    "confirmatory": {
      "type": "object",
      "required": ["overall_record", "pair_records", "seat_records", "wilson_intervals", "order_independent_statistic"],
      "additionalProperties": false,
      "properties": {
        "overall_record": {"$ref": "#/$defs/record"},
        "pair_records": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/record"}},
        "seat_records": {"type": "object"}, "wilson_intervals": {"type": "object"},
        "order_independent_statistic": {"type": "object"}
      }
    },
    "elo": {
      "type": "object",
      "required": ["role", "order_sensitive", "k", "start", "table"],
      "additionalProperties": false,
      "properties": {
        "role": {"const": "descriptive_only"}, "order_sensitive": {"const": true},
        "k": {"type": "number"}, "start": {"type": "number"}, "table": {"type": "array"}
      }
    },
    "holdout": {
      "type": "object",
      "required": ["protocol", "frozen_candidate", "input_closure", "attempt", "seed_manifest", "candidate_hash_match", "seed_domain_isolation"],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "object",
          "required": ["full_matrix", "seed_count", "seat_orders", "one_time", "resume_exact_attempt_only", "candidate_change_invalidates", "candidate_source"],
          "additionalProperties": false,
          "properties": {
            "full_matrix": {"const": true}, "seed_count": {"const": 8},
            "seat_orders": {"const": ["AB", "BA"]}, "one_time": {"const": true},
            "resume_exact_attempt_only": {"const": true},
            "candidate_change_invalidates": {"const": true},
            "candidate_source": {"const": "frozen_git_blob"}
          }
        },
        "frozen_candidate": {"type": "object", "required": ["path", "sha256", "git_ref"]},
        "input_closure": {"type": "object", "required": ["sha256", "before", "after"]},
        "attempt": {
          "type": "object",
          "required": ["index", "attempt_id", "status", "started_at", "completed_at", "published", "invalidated", "invalidation_reason"],
          "properties": {
            "index": {"const": 1}, "status": {"const": "published"},
            "published": {"const": true}, "invalidated": {"const": false},
            "invalidation_reason": {"type": "null"}
          }
        },
        "seed_manifest": {"type": "object", "required": ["attempt_id", "seeds", "sha256"]},
        "candidate_hash_match": {
          "type": "object", "required": ["frozen", "before", "after", "pass"],
          "properties": {"pass": {"const": true}}
        },
        "seed_domain_isolation": {
          "type": "object", "required": ["historical_count", "overlap_count", "pass"],
          "properties": {"overlap_count": {"const": 0}, "pass": {"const": true}}
        }
      }
    },
    "runtime_seconds": {"type": "number", "minimum": 0}
  }
}
