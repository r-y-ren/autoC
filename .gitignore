# ===== autoC .gitignore =====

# 第三方开源工具本地落位（RSSHub 等；见 CAPABILITIES D5 纪律）
tools/

# 运行时状态（新克隆后先运行: python scripts/guard/init_state.py 引导）
.flow/

# 原始大文件快照（需要审计留痕时切换 Git LFS）
kb/raw/*
!kb/raw/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# 构建产物
dist/
build/
*.exe
*.dll

# 系统杂物
.DS_Store
Thumbs.db
desktop.ini

# 会话级临时数据（回放抓取/榜单解压等大文件）
.tmp/
.tmp-online/
.tmp-corpus/
.tmp-dna/
.tmp-intel/
.tmp-r5/
.tmp-v7/
.tmp-v9/
.tmp-mf/
.tmp-mg/
