# ===== autoC .gitignore =====

# 第三方开源工具本地落位（RSSHub 等；见 CAPABILITIES D5 纪律）
tools/

# 运行时状态（新克隆后先运行: python scripts/guard/init_state.py 引导）
.flow/

# 原始大文件快照（需要审计留痕时切换 Git LFS）
kb/raw/*
!kb/raw/.gitkeep

# 外来资料投递暂存（本机消化，产物才入库；约定见 kb/inbox/README.md）
kb/inbox/*
!kb/inbox/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# 构建产物
dist/
build/
*.exe
*.dll

# 系统杂物
.DS_Store
Thumbs.db
desktop.ini

# 会话级临时数据（回放抓取/榜单解压等大文件）
.tmp/
# 2026-09-01 起语料/运行数据归位战役目录（大文件不入库；README 除外）
workspace/kaggriculture/fn_docs/references/data/
workspace/kaggriculture/fn_work/legacy_software/exports/probes/*
!workspace/kaggriculture/fn_work/legacy_software/exports/probes/README.md

.tmp-plant-audit/

# 本机视频插件缓存路径（跨设备无用）
.video_agent/
my_LLM_valut/

# ZCode 客户端本地文件（自动同步生成，不入库）
.zcodeignore
