# ===== contest-compass .gitignore =====

# 第三方开源工具本地落位（RSSHub 等；见 CAPABILITIES D5 纪律）
tools/

# 运行时状态（新克隆后先运行: python scripts/guard/init_state.py 引导）
.flow/

# 原始大文件快照（需要审计留痕时切换 Git LFS）
kb/raw/*
!kb/raw/.gitkeep

# 外来资料投递暂存（本机消化，产物才入库；约定见 kb/inbox/README.md）
kb/inbox/*
!kb/inbox/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# 构建产物
dist/
build/
*.exe
*.dll

# 系统杂物
.DS_Store
Thumbs.db
desktop.ini

# 会话级临时数据（回放抓取/榜单解压等大文件；.tmp-* 通用规则于 2026-10-09 越界修复恢复）
.tmp*/

# 本机视频插件缓存路径（跨设备无用）
.video_agent/
my_LLM_valut/

# ZCode 客户端本地文件（自动同步生成，不入库）
.zcodeignore

# 体积纪律（R12/R19）：原始大件不入 git 主线，本机保存+清单声明
my_LLM_valut/raw/pdfs/

# >>> repo-split >>>（git 拆分：产物分区出主库，见 spec r-y-ren/contest-compass#2）
workspace/*
!workspace/README.md
!workspace/JOURNAL.md
archive/
export/
kb/raw/
# <<< repo-split <<<
