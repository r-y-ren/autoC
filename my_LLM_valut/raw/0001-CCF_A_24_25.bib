@article{liau2025LaserpoweredUAVTrajectory,
  title = {Laser-Powered {{UAV}} Trajectory and Charging Optimization for Sustainable Data-Gathering in the Internet of Things},
  author = {Liau, Yue-Shiuan and Hong, Y.-W. Peter and Sheu, Jang-Ping},
  year = 2025,
  month = may,
