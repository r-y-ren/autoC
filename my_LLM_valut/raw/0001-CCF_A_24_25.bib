@article{wu2024MACOptimizationProtocol,
  title = {{{MAC}} Optimization Protocol for Cooperative {{UAV}} Based on Dual Perception of Energy Consumption and Channel Gain},
  author = {Wu, Jiehong and Zhou, Jianzhou and Yu, Lei and Gao, Lijun},
  year = 2024,
