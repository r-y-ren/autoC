@article{wang2025SmartShieldPrevent,
  title = {Smart Shield: {{Prevent}} Aerial Eavesdropping via Cooperative Intelligent Jamming Based on Multi-Agent Reinforcement Learning},
  shorttitle = {Smart {{Shield}}},
  author = {Wang, Qubeijian and Tang, Shiyue and Sun, Wen and Zhang, Yin and Sun, Geng and Dai, Hong-Ning and Guizani, Mohsen},
  year = 2025,
