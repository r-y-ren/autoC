@article{hoang2024FiniteBlockLength,
  title = {Finite Block Length {{NOMA MU}} Pairing {{UAV-enable}} System: {{Performance}} Analysis and Optimization},
  shorttitle = {Finite {{Block Length NOMA MU Pairing UAV-Enable System}}},
  author = {Hoang, Tran Manh and Nguyen, Ba Cao and Thanh, Huyen Le Thi and Tran, Xuan Nam and Hiep, Pham Thanh},
