@article{zhao2025MultiUAVCooperativeTask,
  title = {A Multi-{{UAV}} Cooperative Task Scheduling in Dynamic Environments: {{Throughput}} Maximization},
  shorttitle = {A {{Multi-UAV Cooperative Task Scheduling}} in {{Dynamic Environments}}},
  author = {Zhao, Liang and Li, Shuo and Tan, Zhiyuan and Hawbani, Ammar and Timotheou, Stelios and Yu, Keping},
  year = 2025,
