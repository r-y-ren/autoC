@article{liu2025ResourceAllocationAdaptive,
  title = {Resource Allocation for Adaptive Beam Alignment in {{UAV-assisted}} Integrated Sensing and Communication Networks},
  author = {Liu, Junyu and Zhou, Chengyi and Sheng, Min and Yang, Haojun and Huang, Xinyu and Li, Jiandong},
  year = 2025,
