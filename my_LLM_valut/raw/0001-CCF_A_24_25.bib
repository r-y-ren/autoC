@article{gui2024CoverageProbabilityThroughput,
  title = {Coverage Probability and Throughput Optimization in Integrated {{mmWave}} and Sub-6 {{GHz}} Multi-{{UAV-assisted}} Disaster Relief Networks},
  author = {Gui, Jinsong and Cai, Fujian},
