@article{jin2025ResourceefficientContentSharing,
  title = {A Resource-Efficient Content Sharing Mechanism in Large-Scale {{UAV}} Named Data Networking},
  author = {Jin, Chenlang and Yao, Haipeng and Mai, Tianle and Xu, Jiaqi and Zhang, Qi and Yu, F. Richard},
  year = 2025,
