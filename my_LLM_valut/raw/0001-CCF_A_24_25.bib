}

@article{liu2024SpaceAirGroundIntegratedNetworks,
  title = {Space-{{Air-Ground Integrated Networks}}: {{Spherical Stochastic Geometry-Based Uplink Connectivity Analysis}}},
  shorttitle = {Space-{{Air-Ground Integrated Networks}}},
  author = {Liu, Yalin and Dai, Hong-Ning and Wang, Qubeijian and Pandey, Om Jee and Fu, Yaru and Zhang, Ning and Niyato, Dusit and Lee, Chi Chung},
