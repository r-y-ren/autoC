}

@article{liu2025HybridOptimizationFramework,
  title = {A Hybrid Optimization Framework for Age of Information Minimization in {{UAV-assisted MCS}}},
  author = {Liu, Yuxin and Deng, Qingyong and Zeng, Zhiwen and Liu, Anfeng and Li, Zhetao},
  year = 2025,
