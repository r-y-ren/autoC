@article{fu2022Energyefficient3DData,
  title = {Energy-Efficient {{3D}} Data Collection for Multi-{{UAV}} Assisted Mobile Crowdsensing},
  author = {Fu, Luwei and Zhao, Zhiwei and Min, Geyong and Miao, Wang and Zhao, Liang and Huang, Wenjie},
  year = 2022,
