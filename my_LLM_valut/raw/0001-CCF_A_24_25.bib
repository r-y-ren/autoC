@article{wang2025JointPositioningComputation,
  title = {Joint Positioning and Computation Offloading in Multi-{{UAV MEC}} for Low Latency Applications: {{A}} Proximal Policy Optimization Approach},
  shorttitle = {Joint {{Positioning}} and {{Computation Offloading}} in {{Multi-UAV MEC}} for {{Low Latency Applications}}},
  author = {Wang, Yuhui and Farooq, Junaid and Ghazzai, Hakim and Setti, Gianluca},
  year = 2025,
  month = oct,
  journal = {IEEE Transactions on Mobile Computing},
  volume = {24},
