@article{li2024MaximizingNetworkThroughput,
  title = {Maximizing {{Network Throughput}} in {{Heterogeneous UAV Networks}}},
  author = {Li, Shuyue and Li, Jing and Xiang, Chaocan and Xu, Wenzheng and Peng, Jian and Wang, Ziming and Liang, Weifa and Yao, Xinwei and Jia, Xiaohua and Das, Sajal K},
  year = 2024,
  month = jun,
  journal = {IEEE/ACM Transactions on Networking},
