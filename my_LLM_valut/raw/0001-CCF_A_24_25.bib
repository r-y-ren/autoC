}

@article{wang2024UAVassistedTargetTracking,
  title = {{{UAV-assisted}} Target Tracking and Computation Offloading in {{USV-based MEC}} Networks},
  author = {Wang, Ziyuan and Du, Jun and Jiang, Chunxiao and Ren, Yong and Zhang, Xiao-Ping},
  year = 2024,
  month = dec,
  journal = {IEEE Transactions on Mobile Computing},
