@article{wang2024UAVAssistedTruthDiscovery,
  title = {A {{UAV-Assisted Truth Discovery Approach With Incentive Mechanism Design}} in {{Mobile Crowd Sensing}}},
  author = {Wang, Ping and Li, Zhetao and Guo, Bin and Long, Saiqin and Guo, Suiming and Cao, Jiannong},
  year = 2024,
  month = apr,
  journal = {IEEE/ACM Transactions on Networking},
  volume = {32},
