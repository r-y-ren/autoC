@article{guo2025MightyLongrangeHighthroughput,
  title = {Mighty: {{Towards}} Long-Range and High-Throughput Backscatter for Drones},
  shorttitle = {Mighty},
  author = {Guo, Xiuzhen and He, Yuan and Shangguan, Longfei and Chen, Yande and Gu, Chaojie and Shu, Yuanchao and Jamieson, Kyle and Chen, Jiming},
  year = 2025,
