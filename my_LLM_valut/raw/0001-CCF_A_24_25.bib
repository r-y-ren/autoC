}

@article{qiu2024IntegratedHostContentCentric,
  title = {Integrated {{Host-}} and {{Content-Centric Routing}} for {{Efficient}} and {{Scalable Networking}} of {{UAV Swarm}}},
  author = {Qiu, Xiaohan and Zhang, Shan and Wang, Zhiyuan and Luo, Hongbin},
  year = 2024,
