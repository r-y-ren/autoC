@article{lei2025EdgeInformationHub,
  title = {Edge Information Hub: {{Orchestrating}} Satellites, {{UAVs}}, {{MEC}}, Sensing and Communications for {{6G}} Closed-Loop Controls},
  shorttitle = {Edge {{Information Hub}}},
  author = {Lei, Chengleyang and Feng, Wei and Wei, Peng and Chen, Yunfei and Ge, Ning and Mao, Shiwen},
  year = 2025,
  month = jan,
  journal = {IEEE Journal on Selected Areas in Communications},
  volume = {43},
  number = {1},
  pages = {5--20},
  issn = {0733-8716, 1558-0008},
  doi = {10.1109/JSAC.2024.3460053},
  urldate = {2025-12-24},
  abstract = {An increasing number of field robots would be used for mission-critical tasks in remote or post-disaster areas. Due to the limited individual abilities, these robots usually require an edge information hub (EIH), with not only communication but also sensing and computing functions. Such EIH could be deployed on a flexibly-dispatched unmanned aerial vehicle (UAV). Different from traditional aerial base stations or mobile edge computing (MEC), the EIH would direct the operations of robots via sensing-communication-computing-control (SC3) closed-loop orchestration. This paper aims to optimize the closed-loop control performance of multiple SC3 loops, with constraints on satellite-backhaul rate, computing capability, and on-board energy. Specifically, the linear quadratic regulator (LQR) control cost is used to measure the closed-loop utility, and a sum LQR cost minimization problem is formulated to jointly optimize the splitting of sensor data and allocation of communication and computing resources. We first derive the optimal splitting ratio of sensor data, and then recast the problem to a more tractable form. An iterative algorithm is finally proposed to provide a sub-optimal solution. Simulation results demonstrate the superiority of the proposed algorithm. We also uncover the influence of SC3 parameters on closed-loop controls, highlighting more systematic understanding.},
  copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  keywords = {/unread},
  annotation = {lei2025EdgeInformationHub\\
lei2025EdgeInformationHub},
  file = {/Users/wupengfei/Zotero/storage/Q79S5Y8I/lei2025EdgeInformationHub.pdf}
}

