@article{nguyen2024DilemmaReliabilitySecurity,
  title = {On the {{Dilemma}} of {{Reliability}} or {{Security}} in {{Unmanned Aerial Vehicle Communications Assisted}} by {{Energy Harvesting Relaying}}},
  author = {Nguyen, Tan N. and Tu, Lam-Thanh and Fazio, Peppino and Van Chien, Trinh and V. Le, Cuong and Binh, Huynh Thi Thanh and Voznak, Miroslav},
  year = 2024,
