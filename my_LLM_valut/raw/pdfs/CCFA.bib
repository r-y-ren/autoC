@article{zhang2020DroneenabledInternetofthingsRelay,
  title = {Drone-Enabled Internet-of-Things Relay for Environmental Monitoring in Remote Areas without Public Networks},
  author = {Zhang, Minghu and Li, Xin},
  year = 2020,
