@article{gao2025ImprovingUserQoE,
  title = {Improving User {{QoE}} via Joint Trajectory and Resource Optimization in Multi-{{UAV}} Assisted {{MEC}}},
  author = {Gao, Yang and Tao, Jun and Xu, Yifan and Wang, Zuyan and Gao, Yu and Wang, Meiling},
  year = 2025,
