@inproceedings{zhang2021StatisticalDelayErrorRate,
  title = {Statistical {{Delay}} and {{Error-Rate Bounded QoS Provisioning}} for {{6G mURLLC Over AoI-Driven}} and {{UAV-Enabled Wireless Networks}}},
  booktitle = {{{IEEE INFOCOM}} 2021 - {{IEEE Conference}} on {{Computer Communications}}},
