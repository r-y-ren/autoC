@article{yan2021OptimalTransmitPower,
  title = {Optimal {{Transmit Power}} and {{Flying Location}} for {{UAV Covert Wireless Communications}}},
  author = {Yan, Shihao and Hanly, Stephen V. and Collings, Iain B.},
