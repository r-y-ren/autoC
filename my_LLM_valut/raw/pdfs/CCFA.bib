}

@article{nabi2025JointOffloadingDecision,
  title = {Joint Offloading Decision, User Association, and Resource Allocation in Hierarchical Aerial Computing: {{Collaboration}} of {{UAVs}} and {{HAP}}},
  shorttitle = {Joint {{Offloading Decision}}, {{User Association}}, and {{Resource Allocation}} in {{Hierarchical Aerial Computing}}},
  author = {Nabi, Ahmadun and Moh, Sangman},
