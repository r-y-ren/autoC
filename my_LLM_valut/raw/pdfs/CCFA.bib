@article{ko2023UAVVelocityFunction,
  title = {{{UAV Velocity Function Design}} and {{Trajectory Planning}} for {{Heterogeneous Visual Coverage}} of {{Terrestrial Regions}}},
  author = {Ko, Yun-Chun and Gau, Rung-Hung},
  year = 2023,
  month = oct,
