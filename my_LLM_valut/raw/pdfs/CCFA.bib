@article{chen2025MultiuserTaskOffloading,
  title = {Multi-User Task Offloading in {{UAV-assisted LEO}} Satellite Edge Computing: {{A}} Game-Theoretic Approach},
  shorttitle = {Multi-{{User Task Offloading}} in {{UAV-Assisted LEO Satellite Edge Computing}}},
  author = {Chen, Ying and Zhao, Jie and Wu, Yuan and Huang, Jiwei and Shen, Xuemin Sherman},
