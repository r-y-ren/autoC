@article{zhang2021AoIDrivenStatisticalDelay,
  title = {{{AoI-Driven Statistical Delay}} and {{Error-Rate Bounded QoS Provisioning}} for {{mURLLC Over UAV-Multimedia 6G Mobile Networks Using FBC}}},
  author = {Zhang, Xi and Wang, Jingqing and Poor, H. Vincent},
  year = 2021,
  month = nov,
  journal = {IEEE Journal on Selected Areas in Communications},
  volume = {39},
