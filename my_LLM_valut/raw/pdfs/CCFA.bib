@article{wu2025DRLbasedTrajectoryOptimization,
  title = {{{DRL-based}} Trajectory Optimization and Computation-Aware Resource Allocation for {{UAV-assisted}} Edge Computing Networks},
  author = {Wu, Xuanguang and Liang, Liang and Wen, Wanli and Huang, Zhen and Liu, Xinyue and Jia, Yunjian},
  year = 2025,
