@article{chai2021MultiUAVTrajectoryPower,
  title = {Multi-{{UAV Trajectory}} and {{Power Optimization}} for {{Cached UAV Wireless Networks With Energy}} and {{Content Recharging-Demand Driven Deep Learning Approach}}},
  author = {Chai, Shuqi and Lau, Vincent K. N.},
  year = 2021,
