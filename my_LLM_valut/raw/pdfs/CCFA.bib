}

@article{kaswan2022SurveyMobileCharging,
  title = {A {{Survey}} on {{Mobile Charging Techniques}} in {{Wireless Rechargeable Sensor Networks}}},
  author = {Kaswan, Amar and Jana, Prasanta K. and Das, Sajal K.},
  year = 2022,
  journal = {IEEE Communications Surveys \& Tutorials},
