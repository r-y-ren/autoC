  file = {/Users/wupengfei/Zotero/storage/EGVL25SK/zhang2023SolvingDynamicTraveling.pdf}
}

@article{zhang2024HumanCentricIrregularRISAssisted,
  title = {Human-{{Centric Irregular RIS-Assisted Multi-UAV Networks With Resource Allocation}} and {{Reflecting Design}} for {{Metaverse}}},
  author = {Zhang, Xiaoqi and Zhang, Haijun and Sun, Kai and Long, Keping and Li, Yonghui},
  year = 2024,
