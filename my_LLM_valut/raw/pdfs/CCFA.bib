}

@article{karmakar2024BlockchainBasedDistributedIntelligent,
  title = {A {{Blockchain-Based Distributed}} and {{Intelligent Clustering-Enabled Authentication Protocol}} for {{UAV Swarms}}},
  author = {Karmakar, Raja and Kaddoum, Georges and Akhrif, Ouassima},
  year = 2024,
