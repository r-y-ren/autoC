  file = {/Users/wupengfei/Zotero/storage/LEFCD4FL/li2025FederatedMetalearningBased.pdf}
}

@article{li2025JointServiceCaching,
  title = {Joint Service Caching and Computation Offloading Scheme with {{3D UAV}} Deployment for {{ICVs}} in {{UAV-assisted VEC}}},
  author = {Li, Chunlin and Jiang, Kun and Zhang, Zhihao and Xiong, Cheng and Wan, Shaohua},
  year = 2025,
