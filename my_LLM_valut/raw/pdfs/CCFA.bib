@article{zhang2022IntelligentCachingUAVAided,
  title = {Intelligent {{Caching}} in {{UAV-Aided Networks}}},
  author = {Zhang, Mingze and {EI-Hajjar}, Mohammed and Ng, Soon Xin},
  year = 2022,
  month = jan,
  journal = {IEEE Transactions on Vehicular Technology},
  volume = {71},
