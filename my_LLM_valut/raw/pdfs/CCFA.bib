@article{zhou2022IntegratedSensingCommunication,
  title = {Integrated {{Sensing}} and {{Communication}} in {{UAV Swarms}} for {{Cooperative Multiple Targets Tracking}}},
  author = {Zhou, Longyu and Leng, Supeng and Wang, Qing and Liu, Qiang},
  year = 2022,
  journal = {IEEE Transactions on Mobile Computing},
