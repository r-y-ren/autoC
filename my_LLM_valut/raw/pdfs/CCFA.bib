@article{li2024UAVsassistedQoSGuarantee,
  title = {{{UAVs-assisted QoS}} Guarantee Scheme of {{IoT}} Applications for Reliable Mobile Edge Computing},
  author = {Li, Xiang and Xiao, Peng and Tang, Di and Li, Xingguo and Wang, Qixu and Chen, Dajiang},
