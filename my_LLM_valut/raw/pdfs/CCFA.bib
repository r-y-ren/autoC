@article{han2022JointDeploymentOptimization,
  title = {Joint {{Deployment Optimization}} and {{Flight Trajectory Planning}} for {{UAV Assisted IoT Data Collection}}: {{A Bilevel Optimization Approach}}},
  shorttitle = {Joint {{Deployment Optimization}} and {{Flight Trajectory Planning}} for {{UAV Assisted IoT Data Collection}}},
  author = {Han, Shoufei and Zhu, Kun and Zhou, MengChu and Liu, Xiaojing},
