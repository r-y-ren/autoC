@article{zhu2024FissionSpectralClustering,
  title = {Fission Spectral Clustering Strategy for {{UAV}} Swarm Networks},
  author = {Zhu, Gepeng and Yao, Haipeng and Mai, Tianle and Wang, Zunliang and Wu, Di and Guo, Song},
  year = 2024,
