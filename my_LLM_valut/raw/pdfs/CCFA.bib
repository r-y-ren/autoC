@article{ma2021UAVLEOIntegratedBackbone,
  title = {{{UAV-LEO Integrated Backbone}}: {{A Ubiquitous Data Collection Approach}} for {{B5G Internet}} of {{Remote Things Networks}}},
  shorttitle = {{{UAV-LEO Integrated Backbone}}},
  author = {Ma, Ting and Zhou, Haibo and Qian, Bo and Cheng, Nan and Shen, Xuemin and Chen, Xiang and Bai, Bo},
  year = 2021,
