@article{tian2024MobiScatterEnhancingCapacity,
  title = {{{MobiScatter}}: {{Enhancing Capacity}} in {{Drone-Assisted High-Concurrency Backscatter Networks}}},
  shorttitle = {{{MobiScatter}}},
  author = {Tian, Xiaohua and Zhu, Fengyuan and Li, Hao and Ouyang, Mingwei and Feng, Luwei and Tong, Xinyu and Wang, Xinbing},
  year = 2024,
  month = feb,
  journal = {IEEE/ACM Transactions on Networking},
  volume = {32},
  number = {1},
  pages = {535--549},
  issn = {1063-6692, 1558-2566},
  doi = {10.1109/TNET.2023.3290168},
  urldate = {2024-07-17},
  abstract = {This paper presents MobiScatter, which enhances capacity of CSS based backscatter networks for accommodating drone-carried access points (APs). CSS based backscatter design has favorable features including long range and high concurrency. However, the concurrency of the network can be reduced by 34\% when the drone-carried AP is introduced due to the mobility and fast fading. In order to maintain high concurrency, MobiScatter presents a series of new designs. In particular, we propose to enhance concurrency of the CSS based backscatter network with symmetric upchirps and downchirps, which neutralizes the impact of imperfect frequency orthogonality. Then, to mitigate the impact of fast fading on decoding, we present a novel half-period chirp modulation scheme for crossed chirps. Finally, we provide a power management method for tags by controlling transmitting time of chirps. We construct a MobiScatter prototype, which contains a drone-carried AP implemented with a mobile USRP and 200 tags. We deploy those tags in an area of 200m \texttimes{} 180 m on a meadow. Experimental results show that MobiScatter can support 160 concurrent backscatter transmissions when the AP moves at 15m/s.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
  keywords = {/unread},
  annotation = {tian2024MobiScatterEnhancingCapacity\\
TLDR: MobiScatter is presented, which enhances capacity of CSS based backscatter networks for accommodating drone-carried access points (APs) by enhancing concurrency of the CSS based backscatter network with symmetric upchirps and downchirps, which neutralizes the impact of imperfect frequency orthogonality.},
  file = {/Users/wupengfei/Documents/OB_Simple_Academic/02-Area/02-Reading/mdnotes/@Tian2024a.md;/Users/wupengfei/Zotero/storage/ADZG63LJ/tian2024MobiScatterEnhancingCapacity.pdf}
}

