}

@article{saha2022SurveillanceUnevenSurface,
  title = {Surveillance of {{Uneven Surface With Self-Organizing Unmanned Aerial Vehicles}}},
  author = {Saha, Dibakar and Pattanayak, Debasish and Mandal, Partha Sarathi},
  year = 2022,
