  file = {/Users/wupengfei/Documents/OB_Simple_Academic/02-Area/02-Reading/mdnotes/@Zhan2024.md;/Users/wupengfei/Zotero/storage/3QZCRYHT/zhan2024TradeoffAgeInformation.pdf}
}

@article{zhan2025OnlineEnergyInterference,
