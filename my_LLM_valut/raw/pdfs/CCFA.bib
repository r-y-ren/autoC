@article{mittal2024DeploymentCostawareUAV,
  title = {Deployment Cost-Aware {{UAV}} and {{BS}} Collaboration in Cell-Free Integrated Aerial-Terrestrial Networks},
  author = {Mittal, Vandana and Tabassum, Hina and Hossain, Ekram},
