@article{li2025TamingEventCameras,
  title = {Taming Event Cameras with Bio-Inspired Architecture and Algorithm: {{A}} Case for Drone Obstacle Avoidance},
  shorttitle = {Taming {{Event Cameras With Bio-Inspired Architecture}} and {{Algorithm}}},
  author = {Li, Danyang and Xu, Jingao and Yang, Zheng and Zhao, Yishujie and Cao, Hao and Liu, Yunhao and Shangguan, Longfei},
