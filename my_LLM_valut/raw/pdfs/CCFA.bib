@article{lin2018TSCATemporalSpatialRealTime,
  title = {{{TSCA}}: {{A Temporal-Spatial Real-Time Charging Scheduling Algorithm}} for {{On-Demand Architecture}} in {{Wireless Rechargeable Sensor Networks}}},
  shorttitle = {{{TSCA}}},
  author = {Lin, Chi and Zhou, Jingzhe and Guo, Chunyang and Song, Houbing and Wu, Guowei and Obaidat, Mohammad S.},
