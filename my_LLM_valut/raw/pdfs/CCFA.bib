@article{wu2024PreciseUAVMMWVision,
  title = {Precise {{UAV MMW-Vision Positioning}}: {{A Modal-Oriented Self-Tuning Fusion Framework}}},
  shorttitle = {Precise {{UAV MMW-Vision Positioning}}},
  author = {Wu, Guangyu and Zhou, Fuhui and Meng, Chengzhen and Li, Xiang-Yang},
  year = 2024,
  month = jan,
  journal = {IEEE Journal on Selected Areas in Communications},
  volume = {42},
