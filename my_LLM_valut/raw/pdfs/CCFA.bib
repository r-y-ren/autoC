}

@article{zhou2025LLMQLLLMenhancedQlearning,
  title = {{{LLM-QL}}: {{A LLM-enhanced Q-learning}} Approach for Scheduling Multiple Parallel Drones},
  shorttitle = {{{LLM-QL}}},
  author = {Zhou, Qian and Wu, Jiayang and Zhu, Mengyue and Zhou, Yuhang and Xiao, Fu and Zhang, Yanchun},
