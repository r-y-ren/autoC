  booktitle = {Proceedings of the 29th {{Annual International Conference}} on {{Mobile Computing}} and {{Networking}}},
  author = {Zhang, Bin-Bin and Zhang, Dongheng and Song, Ruiyuan and Wang, Binquan and Hu, Yang and Chen, Yan},
