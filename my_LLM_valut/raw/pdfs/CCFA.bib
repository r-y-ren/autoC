@article{wu2020TrajectoryOptimizationUAVs,
  title = {Trajectory {{Optimization}} for {{UAVs}}' {{Efficient Charging}} in {{Wireless Rechargeable Sensor Networks}}},
  author = {Wu, Pengfei and Xiao, Fu and Sha, Chao and Huang, Haiping and Sun, Lijuan},
  year = 2020,
