@article{xu2021StrategicLearningApproach,
  title = {Strategic {{Learning Approach}} for {{Deploying UAV-Provided Wireless Services}}},
  author = {Xu, Xinping and Duan, Lingjie and Li, Minming},
  year = 2021,
  month = mar,
