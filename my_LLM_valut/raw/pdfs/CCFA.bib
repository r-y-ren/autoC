@article{wang2025JointOptimizationBeamforming,
  title = {Joint Optimization of Beamforming and Trajectory for {{UAV-RIS-assisted MU-MISO}} Systems Using {{GNN}} and {{SD3}}},
  author = {Wang, Shumo and Song, Xiaoqin and Song, Tiecheng and Yang, Yang},
  year = 2025,
