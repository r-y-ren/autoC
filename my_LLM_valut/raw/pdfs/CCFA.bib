@article{wei2024HierarchicalNetworkSlicing,
  title = {Hierarchical Network Slicing for {{UAV-assisted}} Wireless Networks with Deployment Optimization},
  author = {Wei, Fengsheng and Feng, Gang and Qin, Shuang and Peng, Youkun and Liu, Yijing},
  year = 2024,
