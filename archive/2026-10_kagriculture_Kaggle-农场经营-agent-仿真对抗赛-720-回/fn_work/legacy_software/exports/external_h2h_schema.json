{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaggriculture.external-h2h.schema.json",
  "title": "Kaggriculture external black-box H2H evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "evidence_scope", "engine", "candidate", "opponents", "seed_domain", "schedule", "games", "summary", "input_closure", "command", "digests"],
  "properties": {
    "schema_version": {"const": "external-h2h/2.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "development_only", "formal_promotion_eligible", "holdout_evidence", "limitations"],
      "properties": {
        "kind": {"const": "external_black_box_stress"},
        "development_only": {"const": true},
        "formal_promotion_eligible": {"const": false},
        "holdout_evidence": {"const": false},
        "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "scenario", "wheel_path", "wheel_sha256", "runtime_attestation"],
      "properties": {
        "name": {"const": "kaggle-environments"},
        "version": {"enum": ["1.32.7", "1.32.7+nodeps"]},
        "scenario": {"const": "kaggriculture"},
        "wheel_path": {"type": "string", "minLength": 1},
        "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_root", "files", "matches_vendored_wheel"],
          "properties": {
            "package_root": {"type": "string", "minLength": 1},
            "matches_vendored_wheel": {"const": true},
            "files": {
              "type": "object",
              "additionalProperties": false,
              "required": ["__init__.py", "core.py", "agent.py", "utils.py", "errors.py", "status_codes.json", "envs/kaggriculture/kaggriculture.py", "envs/kaggriculture/kaggriculture.json"],
              "properties": {
                "__init__.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "core.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "agent.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "utils.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "errors.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "status_codes.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "envs/kaggriculture/kaggriculture.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "envs/kaggriculture/kaggriculture.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "role", "status", "active_candidate_contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["working", "frozen", "published"]},
        "status": {"enum": ["development", "frozen", "published"]},
        "active_candidate_contract": {"type": "string", "minLength": 1}
      }
    },
    "opponents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "provenance", "license", "use_restriction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["author", "source", "source_url", "acquired_at"],
            "properties": {
              "author": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "source_url": {"type": "string", "format": "uri"},
              "acquired_at": {"type": "string", "minLength": 1}
            }
          },
          "license": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "spdx": {"type": ["string", "null"]}
            }
          },
          "use_restriction": {"type": "string", "minLength": 1}
        }
      }
    },
    "seed_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "seeds", "holdout"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "not": {"const": "holdout"}},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "holdout": {"const": false}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "seat_orders", "opponent_ids", "expected_games"],
      "properties": {
        "policy": {"const": "paired_ab_ba"},
        "seat_orders": {"const": ["AB", "BA"]},
        "opponent_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_games": {"type": "integer", "minimum": 2}
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["game_id", "opponent_id", "seed", "seat", "players", "candidate_seat", "statuses", "contract_ok", "rewards", "winner", "margin", "episode_steps", "states", "completion_ok", "activity", "abnormal_reason", "elapsed_seconds"],
        "properties": {
          "game_id": {"type": "string", "minLength": 1},
          "opponent_id": {"type": "string", "minLength": 1},
          "seed": {"type": "integer"},
          "seat": {"enum": ["AB", "BA"]},
          "players": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "candidate_seat": {"type": "integer", "enum": [0, 1]},
          "statuses": {"const": ["DONE", "DONE"]},
          "contract_ok": {"const": true},
          "rewards": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "winner": {"type": ["string", "null"]},
          "margin": {"type": "number"},
          "episode_steps": {"const": 720},
          "states": {"const": 720},
          "completion_ok": {"const": true},
          "activity": {
            "type": "object",
            "additionalProperties": false,
              "required": ["states", "decisions", "starting_money", "completion_ok", "activity_ok", "ok", "contract_status", "independently_recomputed", "seats"],

              "properties": {
              "states": {"type": "integer", "minimum": 0},
              "decisions": {"type": "integer", "minimum": 0},
              "starting_money": {"type": "number"},

              "completion_ok": {"type": "boolean"},
              "activity_ok": {"type": "boolean"},
              "ok": {"type": "boolean"},
              "contract_status": {"const": "producer_attested"},
              "independently_recomputed": {"const": false},
              "seats": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["decisions", "non_pass_decisions", "effective_commands", "max_pass_streak", "non_pass_trace", "state_change_trace", "reward_delta", "pass_only", "reasons", "policy", "evidence"],
                  "properties": {
                    "decisions": {"type": "integer", "minimum": 0},
                    "non_pass_decisions": {"type": "integer", "minimum": 0},
                    "effective_commands": {"type": "integer", "minimum": 0},
                    "max_pass_streak": {"type": "integer", "minimum": 0},
                    "non_pass_trace": {"type": "array", "items": {"type": "boolean"}},
                    "state_change_trace": {"type": "array", "items": {"type": "boolean"}},
                    "reward_delta": {"type": "number"},
                    "pass_only": {"type": "boolean"},
                    "reasons": {"type": "array", "items": {"type": "string"}},
                    "policy": {"type": "object"},
                    "evidence": {
                      "type": "object", "additionalProperties": false,
                      "required": ["action_count", "non_pass_action_count", "state_change_count", "state_count", "reward_delta", "non_pass_trace", "state_change_trace", "evidence_digest"],
                      "properties": {
                        "action_count": {"type": "integer", "minimum": 0}, "non_pass_action_count": {"type": "integer", "minimum": 0},
                        "state_change_count": {"type": "integer", "minimum": 0}, "state_count": {"type": "integer", "minimum": 0},
                        "reward_delta": {"type": "number"},
                        "non_pass_trace": {"type": "array", "items": {"type": "boolean"}},
                        "state_change_trace": {"type": "array", "items": {"type": "boolean"}},
                        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                      }
                    }
                  }
                }
              }
            }
          },
          "abnormal_reason": {"type": "null"},
          "elapsed_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "summary": {"type": "object", "required": ["overall", "by_opponent", "by_seat"]},
    "input_closure": {
      "type": "object",
      "required": ["algorithm", "before", "after", "unchanged"],
      "properties": {
        "algorithm": {"const": "sha256-path-map-v1"},
        "before": {"type": "object"},
        "after": {"type": "object"},
        "unchanged": {"const": true}
      }
    },
    "command": {
      "type": "object",
      "required": ["argv", "cwd", "parameters"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "parameters": {"type": "object"}
      }
    },
    "digests": {
      "type": "object",
      "required": ["algorithm", "canonical_payload_sha256"],
      "properties": {
        "algorithm": {"const": "canonical-json-sha256"},
        "canonical_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
