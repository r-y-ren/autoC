[{"sha":"b32512260d9a3944964bdf960bf89a8de5b9ff1b","node_id":"C_kwDOUqbA59oAKGIzMjUxMjI2MGQ5YTM5NDQ5NjRiZGY5NjBiZjg5YThkZTViOWZmMWI","commit":{"author":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-30T00:41:35Z"},"committer":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-30T00:41:35Z"},"message":"Switch to tetsutani step1009 with a deeper sale look-ahead\n\ntetsutani republished on Sep 28 (step1009), and the ladder filled with\ncopies of it: replays of six recent ladder losses reproduce step1009 or\nnear variants, and it beats our horizon-48 build 72-82% by small\nmargins. The v9 race horizon has no effect on the new build, but its\nready-stock sale look-ahead layers do.\n\nmain.py is step1009 with _S809_LOOK = 12 (upstream 3). On fresh seeds\n9500-9529 it beats plain step1009 85% and matches it against the horizon-\n48 build, Seven-Turn Rescue, Ledger V68 and the 2965 hybrid. A second\nvariant, _S738_LOOK = 8 and _S809_LOOK = 8, is uploaded to the other\nslot: 80% vs plain step1009 and 57% head to head against main.py.\n\nagents/public/tetsutani_step1009.py is the unmodified upstream file.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"ed16f1b4782cb51305c304ab7721c6e50e4953ac","url":"https://api.github.com/repos/doanthuan/kaggriculture/git/trees/ed16f1b4782cb51305c304ab7721c6e50e4953ac"},"url":"https://api.github.com/repos/doanthuan/kaggriculture/git/commits/b32512260d9a3944964bdf960bf89a8de5b9ff1b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/b32512260d9a3944964bdf960bf89a8de5b9ff1b","html_url":"https://github.com/doanthuan/kaggriculture/commit/b32512260d9a3944964bdf960bf89a8de5b9ff1b","comments_url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/b32512260d9a3944964bdf960bf89a8de5b9ff1b/comments","author":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","html_url":"https://github.com/doanthuan/kaggriculture/commit/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd"}]},{"sha":"f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","node_id":"C_kwDOUqbA59oAKGYwY2JkMzlmYjNiMzNkMjQ5MzQ3NDg1ZDFmY2JiNGE3ZDJiYTllZmQ","commit":{"author":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-27T23:48:38Z"},"committer":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-27T23:48:38Z"},"message":"Replay top teams' ladder games as route plans\n\nThe public pool no longer separates agents, so tools/tape.py builds\nopponents from top-ladder replays. A tape replays one seat of a recorded\nepisode on its seed and is held to the trades it made on the ladder, so it\nstays in sync until about step 620. Against 184 tapes of the top 20 teams,\nmain.py wins 35%, while the real 2600+ opponents in those games won 44%.\ntools/tape_ledger.py shows where the money goes: the leaders run eight\ngeese, where we run two.\n\nproto/leader.py keeps tetsutani's chassis and replaces its routes with a\nlibrary of Boey's recorded games, chosen by the shops the town unlocks.\nIt adds a land catch-up, a helper hand that feeds animals about to\nescape, and the chassis sell-off at the last turn. It wins 52.7% of the\ntapes (mean margin +$1.8k) and 55% against main.py, Ledger V68, the 2965\nhybrid and Melons. It was submitted as ref 56613129. proto/README.md lists\nthe variants that did worse.\n\ntools/fetch_tapes.py, build_library.py and build_submission.py download\nthe episodes, build the library and embed it into one agent file.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"3ddb566a2b6b1d62f8c74b6c09d88ed72f3aeb8d","url":"https://api.github.com/repos/doanthuan/kaggriculture/git/trees/3ddb566a2b6b1d62f8c74b6c09d88ed72f3aeb8d"},"url":"https://api.github.com/repos/doanthuan/kaggriculture/git/commits/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","html_url":"https://github.com/doanthuan/kaggriculture/commit/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd","comments_url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/f0cbd39fb3b33d249347485d1fcbb4a7d2ba9efd/comments","author":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b7cd32202b34adbc65e77a38fcda28944c55beb0","url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/b7cd32202b34adbc65e77a38fcda28944c55beb0","html_url":"https://github.com/doanthuan/kaggriculture/commit/b7cd32202b34adbc65e77a38fcda28944c55beb0"}]},{"sha":"b7cd32202b34adbc65e77a38fcda28944c55beb0","node_id":"C_kwDOUqbA59oAKGI3Y2QzMjIwMmIzNGFkYmM2NWU3N2EzOGZjZGEyODk0NGM1NWJlYjA","commit":{"author":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-27T01:43:40Z"},"committer":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-27T01:43:40Z"},"message":"Race premium sales 48 turns ahead to beat tetsutani copies\n\nmain.py is tetsutani's agent with V9_RACE_DEFAULT and V9_RACE_MAX set to\n48 (upstream 44 and 48). Exact copies of tetsutani tie each other, and\n31 of our first 176 ladder games were such ties. Reserving planned\npremium sales four turns deeper sells each lot just before an\nunmodified copy does. On fresh seeds 9300-9339 (both seats, 80 games) it\nbeats plain tetsutani 65% and matches it against Ledger V68 (71% vs\n70%). On seeds 9100-9124 it is within noise of plain tetsutani against\nthe 2965 hybrid, Melons, the 2945 Farm and Metav4. Deeper settings\n(52/56, 56/64) did worse, and _RACE_HORIZON_MIRROR has no effect.\n\nagents/overlays/clone_counter.py is a negative result kept for\nreference: a one-turn, debt-tracked sale advance applied outside the\nparent lost narrowly to plain tetsutani, because the parent already\nreserves 44 turns ahead and its race layer does not see changes made\noutside it. tools/build_overlay.py appends an overlay to a parent agent.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"604be7171e25a0a05a6f5d9fd6e3644bb4a40e5c","url":"https://api.github.com/repos/doanthuan/kaggriculture/git/trees/604be7171e25a0a05a6f5d9fd6e3644bb4a40e5c"},"url":"https://api.github.com/repos/doanthuan/kaggriculture/git/commits/b7cd32202b34adbc65e77a38fcda28944c55beb0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/b7cd32202b34adbc65e77a38fcda28944c55beb0","html_url":"https://github.com/doanthuan/kaggriculture/commit/b7cd32202b34adbc65e77a38fcda28944c55beb0","comments_url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/b7cd32202b34adbc65e77a38fcda28944c55beb0/comments","author":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cf8bb493fe651e732cbfa4c596b574b4adcc5b22","url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/cf8bb493fe651e732cbfa4c596b574b4adcc5b22","html_url":"https://github.com/doanthuan/kaggriculture/commit/cf8bb493fe651e732cbfa4c596b574b4adcc5b22"}]},{"sha":"cf8bb493fe651e732cbfa4c596b574b4adcc5b22","node_id":"C_kwDOUqbA59oAKGNmOGJiNDkzZmU2NTFlNzMyY2JmYTRjNTk2YjU3NGI0YWRjYzViMjI","commit":{"author":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-25T08:21:41Z"},"committer":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-25T08:21:41Z"},"message":"Record the seven-agent round-robin in the pool README\n\ntetsutani wins 70-100% against every other agent (mean 89.3%), ahead of\nLedger V68 (68.7%), the 2965 hybrid (67.7%) and Melons (58.0%). Seeds\n9100-9124, both seats, 50 matches per pair, corrected loader.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"0b2b7e51bbe3315372c93fb53d2722e46585e952","url":"https://api.github.com/repos/doanthuan/kaggriculture/git/trees/0b2b7e51bbe3315372c93fb53d2722e46585e952"},"url":"https://api.github.com/repos/doanthuan/kaggriculture/git/commits/cf8bb493fe651e732cbfa4c596b574b4adcc5b22","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/cf8bb493fe651e732cbfa4c596b574b4adcc5b22","html_url":"https://github.com/doanthuan/kaggriculture/commit/cf8bb493fe651e732cbfa4c596b574b4adcc5b22","comments_url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/cf8bb493fe651e732cbfa4c596b574b4adcc5b22/comments","author":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fe22725268672cc427f37c179d2c014e14058260","url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/fe22725268672cc427f37c179d2c014e14058260","html_url":"https://github.com/doanthuan/kaggriculture/commit/fe22725268672cc427f37c179d2c014e14058260"}]},{"sha":"fe22725268672cc427f37c179d2c014e14058260","node_id":"C_kwDOUqbA59oAKGZlMjI3MjUyNjg2NzJjYzQyN2YzN2MxNzlkMmMwMTRlMTQwNTgyNjA","commit":{"author":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-25T08:10:22Z"},"committer":{"name":"Doan Thuan","email":"8563680+doanthuan@users.noreply.github.com","date":"2026-09-25T08:10:22Z"},"message":"Make tetsutani Demand-Preserving the Champion and fix agent loading\n\nThe eval tools loaded `agent` by name, but Kaggle runs the last callable\ndefined in main.py. For five pool agents (Ahmed V48 and V55, both Kaito\nagents, tetsutani) the harness was playing a stale inner bot.\ntools/eval.py, ledger.py and run.py now load agents with\nkaggle_environments.agent.get_last_callable, and run.py reloads the agent\nfresh for every seed.\n\nWith the corrected loader, tetsutani's agent beats Melons 47-3, and in a\nseven-agent round-robin (seeds 9100-9124, both seats) it wins 70-100%\nagainst every other agent. main.py is now that agent, byte-identical to\nthe notebook output, with NOTICE.txt updated for its lineage.\n\nFive newer public agents join the pool: Ahmed V57, haideptry 2965\nhybrid, shiiin9 order-book, Harvest Ledger V68 and Rayk C95. C95 has no\nstated license, so it is git-ignored.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"09833c70a0654bb38be13aea877637322e550d76","url":"https://api.github.com/repos/doanthuan/kaggriculture/git/trees/09833c70a0654bb38be13aea877637322e550d76"},"url":"https://api.github.com/repos/doanthuan/kaggriculture/git/commits/fe22725268672cc427f37c179d2c014e14058260","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/fe22725268672cc427f37c179d2c014e14058260","html_url":"https://github.com/doanthuan/kaggriculture/commit/fe22725268672cc427f37c179d2c014e14058260","comments_url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/fe22725268672cc427f37c179d2c014e14058260/comments","author":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"doanthuan","id":8563680,"node_id":"MDQ6VXNlcjg1NjM2ODA=","avatar_url":"https://avatars.githubusercontent.com/u/8563680?v=4","gravatar_id":"","url":"https://api.github.com/users/doanthuan","html_url":"https://github.com/doanthuan","followers_url":"https://api.github.com/users/doanthuan/followers","following_url":"https://api.github.com/users/doanthuan/following{/other_user}","gists_url":"https://api.github.com/users/doanthuan/gists{/gist_id}","starred_url":"https://api.github.com/users/doanthuan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/doanthuan/subscriptions","organizations_url":"https://api.github.com/users/doanthuan/orgs","repos_url":"https://api.github.com/users/doanthuan/repos","events_url":"https://api.github.com/users/doanthuan/events{/privacy}","received_events_url":"https://api.github.com/users/doanthuan/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"379e1451e309f65a4bd02d31364ff68024455af2","url":"https://api.github.com/repos/doanthuan/kaggriculture/commits/379e1451e309f65a4bd02d31364ff68024455af2","html_url":"https://github.com/doanthuan/kaggriculture/commit/379e1451e309f65a4bd02d31364ff68024455af2"}]}]