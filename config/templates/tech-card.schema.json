{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autoc/tech-card",
  "title": "KB-2 技术卡片 frontmatter（kb/tech/cards 按规范化 ID 命名）",
  "type": "object",
  "required": ["id", "name", "field", "published", "maturity", "directions", "competition_fit", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "规范化主键：arXiv ID / GitHub repo / DOI" },
    "name": { "type": "string" },
    "field": { "type": "array", "items": { "type": "string" } },
    "directions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "关联方向（来自 config/directions；跨方向复用的卡片可多值；简报按此过滤）"
    },
    "published": { "type": "string", "format": "date" },
    "maturity": { "enum": ["paper", "demo", "product"] },
    "venue_tier": {
      "enum": ["CCF-A", "CCF-B", "CCF-C", "Survey", "arXiv", "workshop", "industry", "other"],
      "description": "可选（2026-09-16 词表移植自 my_LLM_valut）：论文发表层级；存量卡不填合法，deep-sync 老化重验时顺补；vault-distill 提炼卡强制填写"
    },
    "evidence_tier": {
      "enum": ["core", "supporting", "exploratory"],
      "description": "可选（词表移植）：证据分层——core=本卡主张的直接证据 / supporting=旁证 / exploratory=探索性"
    },
    "paper_role": {
      "enum": ["anchor", "supporting", "background"],
      "description": "可选（词表移植）：论文在其方向卡组中的角色（锚点/支撑/背景）"
    },
    "reproducibility_level": {
      "enum": ["high", "medium", "low"],
      "description": "可选（词表移植）：复现难度（有代码可跑=high … 需从零自建=low）"
    },
    "signal": {
      "type": "object",
      "properties": {
        "venue": { "type": "string" },
        "stars": { "type": "integer" },
        "citations_90d": { "type": "integer" },
        "runnable": { "type": "boolean", "description": "有无可运行 demo/开源实现" }
      }
    },
    "competition_fit": {
      "type": "array",
      "minItems": 1,
      "description": "比赛映射——KB-2 的灵魂字段，缺失则卡片不入库",
      "items": {
        "type": "object",
        "required": ["track", "edge", "reuse_cost"],
        "properties": {
          "track": {
          "enum": ["数模-预测与评估", "数模-数据分析与决策", "双创-文书与申报", "黑客松-数据与算法", "Kaggle-竞赛", "ACM-训练体系"],
          "description": "统一赛种词表（六大类）：匹配与聚合的稳定口径，禁自造措辞"
        },
          "edge": { "type": "string", "description": "能形成的差异化" },
          "reuse_cost": { "enum": ["低", "中", "高"] },
          "open_source": { "type": "string", "description": "现成开源实现链接" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "两种形态二选一（逐条）：常规实抓={url+accessed}；paper-distill={paper_title+distilled_from+distilled_date}（仅限 vault-distill 提炼跑批，铁律 1 受控放宽边界见 AGENTS.md）",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/sourceUrl" },
          { "$ref": "#/definitions/sourcePaperDistill" }
        ]
      }
    }
  },
  "definitions": {
    "sourceUrl": {
      "type": "object",
      "required": ["url", "accessed"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "accessed": { "type": "string", "format": "date" }
      }
    },
    "sourcePaperDistill": {
      "type": "object",
      "required": ["paper_title", "distilled_from", "distilled_date"],
      "properties": {
        "paper_title": { "type": "string", "description": "溯源锚点：论文标题（必标，用户溯源用）" },
        "doi": { "type": "string", "description": "bib 回填的 DOI（尽力而为，可缺省）" },
        "url": { "type": "string", "description": "bib 回填的出版页/仓库链接（可选）" },
        "distilled_from": { "type": "string", "description": "提炼来源库标识（如 my_LLM_valut）" },
        "distilled_date": { "type": "string", "format": "date" }
      }
    }
  }
}
